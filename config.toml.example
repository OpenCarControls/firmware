# ==============================================
#    OPEN CAR INTERFACE - BUILD CONFIGURATION
# ==============================================

[target]
# Optional: Inherit hardware configuration from a profile in `hardware-profiles/`
# Any settings defined in the `[hardware]` section below will override the profile.
hardware_profile = "meatpi-wican-esp32c3"

# Select which board family you want to use. See the available boards in `boards/`
# (This is automatically set by the hardware_profile if one is used)
# board = "esp"

# Select which platform (vehicle crate) you want to use. See the available platforms in `cars/`
platform = "virtual-car"

# ===================================
#    BOARD SPECIFIC CONFIGURATIONS
# ===================================
# When using a `hardware_profile` above, you can leave these sections commented out 
# unless you specifically want to override a value from the profile.

# [hardware.esp]
# mcu = "esp32c3"

[hardware.esp.ble]
device_name = "OpenCar"
pairing_button_hold_s = 3
max_bonded_phones = 8
controller_lease_ttl_s = 15

# [[hardware.esp.can_buses]]
# interface = "twai"
# tx_pin = 0
# rx_pin = 3
# enable_pin = 6
# enable_level = "low"
# bitrate = 500000  # TWAI only: 125000, 250000, 500000 (default) or 1000000. xtask checks it against the vehicle.

# [hardware.pc]

[hardware.pc.ble]
device_name = "OpenCar"
http_port = 4242
max_bonded_phones = 8
paired_phones_file = "/tmp/opencar-paired-phones.txt"

# CAN bus definitions — order determines bus_id (0-based).
# Each entry maps to a SocketCAN network interface (real or virtual).
[[hardware.pc.can_buses]]
interface = "vcan0"

# ===========================
#    NETWORK CONFIGURATION
# ===========================

[network.wifi]
enabled = true
ssid = "YourSSID"
password = "YourPassword"

# SavvyCAN logger: streams every CAN frame to SavvyCAN over WiFi (add a "Network
# connection" in SavvyCAN's Connection > Open Connection Window, type GVRET, this
# device's IP and `port`). While SavvyCAN is connected the buses are read-only and the
# vehicle receives no frames. The port has no authentication, so keep it off unless
# you are reverse engineering a car on a network you trust.
[network.can_logger]
enabled = false
port = 23

[network.mqtt]
# Use mqtt:// for basic auth (plain TCP). Use mqtts:// for mTLS.
broker_url = "mqtt://192.168.0.100:1883"
client_id = "dev-car"

# Specify the type of authentication to the broker.
# - `basic` is for username/password combo (no certs needed)
# - `mtls` is for using mTLS with certificates
auth_mode = "basic"

# Basic authentication configuration
username = "user"
password = "password"

# mTLS authentication configuration (only used when auth_mode = "mtls")
ca_cert_file = "certs/ca.pem"
client_cert_file = "certs/client_cert.pem"
client_key_file = "certs/client_key.pem"
