{
    "name": "Open Car — Firmware",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // USB access for flashing, probe-rs and the serial monitor without
    // --privileged: /dev is bind-mounted so hot-plugged devices appear, and only
    // these device classes are allowed.
    "mounts": [
        {
            "type": "bind",
            "source": "/dev",
            "target": "/dev"
        }
    ],
    "runArgs": [
        // 4242 is the PC board's debug HTTP server. It listens on 127.0.0.1 by
        // default, so the published port only reaches it with
        // [hardware.pc.ble].http_bind = "0.0.0.0" in config.toml.
        "-p",
        "4242:4242",
        "--device-cgroup-rule=c 166:* rmw", // ttyACM: native USB-JTAG serial (C3/C6/S3)
        "--device-cgroup-rule=c 188:* rmw", // ttyUSB: USB-UART bridges (classic ESP32)
        "--device-cgroup-rule=c 189:* rmw" // raw USB: probe-rs, espflash over JTAG
    ],
    "forwardPorts": [
        4242
    ],
    // Point rust-analyzer at the board selected in config.toml.
    "postCreateCommand": "cargo xtask ide",
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "vivaxy.vscode-conventional-commits",
                "dotenv.dotenv-vscode",
                "EditorConfig.EditorConfig",
                "chneau.resource-monitor",
                "FanaticPythoner.better-todo-tree",
                "mk12.better-git-line-blame",
                "bufbuild.vscode-buf",
                "probe-rs.probe-rs-debugger",
                "ms-vscode.vscode-serial-monitor"
            ],
            "settings": {
                "serialmonitor.defaultPort": "/dev/ttyACM0",
                "serialmonitor.defaultBaudRate": 115200
            }
        }
    },
    "remoteUser": "vscode"
}
