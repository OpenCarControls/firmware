{
    "name": "Open Car — PC",
    "build": {
        "dockerfile": "../Dockerfile",
        "target": "pc"
    },
    "runArgs": [
        "-p",
        "4242:4242"
    ],
    "forwardPorts": [
        4242
    ],
    "mounts": [
        {
            "source": "/workspaces/contracts",
            "target": "/workspaces/contracts",
            "type": "bind"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "vivaxy.vscode-conventional-commits",
                "dotenv.dotenv-vscode",
                "EditorConfig.EditorConfig",
                "chneau.resource-monitor",
                "FanaticPythoner.better-todo-tree",
                "mk12.better-git-line-blame",
                "bufbuild.vscode-buf"
            ],
            "settings": {
                "rust-analyzer.cargo.features": ["dev-pc"]
            }
        }
    },
    "remoteUser": "vscode"
}
